# Sanity — leave blank locally until a real project exists.
# The app builds and runs with empty-content fallbacks when these are unset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Instagram — leave blank locally until a real Graph API token + business
# account id exist. The homepage/footer Instagram strip falls back to
# placeholder tiles when these are unset.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ActiveCampaign — leave blank locally until the client provides real
# credentials. The "Join the VIP List" newsletter form (see
# src/components/marketing/NewsletterBand.tsx) falls back to a no-op
# success when these are unset, matching this project's existing
# "fail safely" pattern. Server-side only — never expose as NEXT_PUBLIC_.
# ACTIVE_CAMPAIGN_API_URL is the account-specific API base (e.g.
# https://youraccountname.api-us1.com), used as
# ${ACTIVE_CAMPAIGN_API_URL}/api/3; ACTIVE_CAMPAIGN_API_KEY is sent as the
# Api-Token header. ACTIVE_CAMPAIGN_LIST_ID and ACTIVE_CAMPAIGN_TAG_ID are
# each optional — if set, new newsletter contacts are also subscribed to
# that list / tagged with that tag; if unset, contacts are only
# created/updated. Confirmed old-site values, verified against the
# account's own "CP Homepage Form" (AC Form ID 10) migration audit:
#   ACTIVE_CAMPAIGN_LIST_ID=3   (DTP Master)
#   ACTIVE_CAMPAIGN_TAG_ID=8    (Container Park)
ACTIVE_CAMPAIGN_API_URL=
ACTIVE_CAMPAIGN_API_KEY=
ACTIVE_CAMPAIGN_LIST_ID=
ACTIVE_CAMPAIGN_TAG_ID=

# SMTP — Contact and Leasing form notifications, sent to
# info@containerpark.com (see src/lib/email/client.ts). Server-side only —
# never expose as NEXT_PUBLIC_. Leave blank locally: submissions are logged
# to the console instead. In production, unset SMTP makes those two forms
# show their error state rather than silently dropping inquiries.
# SMTP_PORT defaults to 587 (STARTTLS); set SMTP_SECURE=true for port 465.
# EMAIL_FROM must be an address the SMTP account is allowed to send as,
# e.g. "Downtown Container Park Website <no-reply@downtowncontainerpark.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
